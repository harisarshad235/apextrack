# ==============================================================================
# Kynov Environment Variables Configuration Template
# Copy this file to .env.local (for Next.js dev) or .dev.vars (for Wrangler/OpenNext)
# Never commit .env.local or .dev.vars to Git!
# ==============================================================================

# Core Application Settings
AUTH_MODE=production
NEXT_PUBLIC_APP_URL=https://kynov.harisarshad.site

# Session & Security (Mandatory in production)
# Generate a secure 64-char hex key: openssl rand -hex 32
SESSION_SECRET=your_high_entropy_session_secret_hex_or_string
NEXTAUTH_SECRET=your_high_entropy_session_secret_hex_or_string

# Email Service (Resend)
# Required for password reset flow, admin new user alerts, and mention notifications
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Kynov <notifications@harisarshad.site>
RESEND_REPLY_TO=harisarshad235@gmail.com

# Google OAuth 2.0 (Single Sign-On)
# Configure authorized redirect URI: https://<domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth App (Single Sign-On)
# Configure authorized callback URL: https://<domain>/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# GitHub Webhooks (Optional Issue Linking)
# Secret configured on your GitHub repository webhook settings
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
