{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apextrack",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "apex.harisarshad.site",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "apextrack_db",
      "database_name": "apextrack_db",
      "database_id": "b92298b4-1644-491d-9aa1-70402d4a0881",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "apextrack-attachments"
    }
  ],
  "vars": {
    "AUTH_MODE": "dev",
    "PROJECT_KEY": "APEX"
  }
}